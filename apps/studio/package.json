{
  "name": "conductor-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Conductor Studio \u2014 Maestro test workbench, agentic test writing, and test case management",
  "author": "Houwert",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"pnpm build:electron && electron .\"",
    "dev:vite": "vite",
    "build:electron": "node build-electron.mjs",
    "build": "tsc --noEmit && pnpm typecheck:electron && vite build && pnpm build:electron",
    "typecheck:app": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.main.json --noEmit",
    "dist": "pnpm build && electron-builder --config electron-builder.yml",
    "dist:dev": "pnpm build && electron-builder --config electron-builder.yml",
    "dist:release": "pnpm build && electron-builder --config electron-builder.release.cjs --publish always",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@conductor/studio-ui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^4.0.0",
    "electron-updater": "^6.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.21.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "0.27.4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
