{
  "name": "@houwert/conductor",
  "version": "0.33.3",
  "description": "UI automation CLI for AI agents. Drive and inspect iOS, tvOS, Android, Fire TV, Roku, macOS and web apps from the terminal.",
  "keywords": [
    "ai-agents",
    "ui-automation",
    "mobile-testing",
    "e2e-testing",
    "ios",
    "tvos",
    "android",
    "fire-tv",
    "roku",
    "macos",
    "playwright",
    "xcuitest",
    "simulator",
    "maestro",
    "claude-code",
    "react-native"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DouweBos/conductor"
  },
  "homepage": "https://houwert.dev/conductor/",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "conductor": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "proto/",
    "skills/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "tsc -p tests/tsconfig.json && node dist-tests/tests/all-tests.js",
    "lint": "eslint src && prettier --check src",
    "lint:fix": "eslint src --fix && prettier --write src"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.15",
    "js-yaml": "^4.1.1",
    "minimist": "^1.2.8",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.52.0",
    "pngjs": "^7.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.56.1"
  },
  "bugs": {
    "url": "https://github.com/DouweBos/conductor/issues"
  }
}
