{
  "setup": {
    "copy": [
      ".claude",
      "node_modules",
      "apps/studio/node_modules",
      "packages/cli/node_modules",
      "packages/studio-ui/node_modules"
    ],
    "symlink": [],
    "commands": [
      "mise trust",
      "mise install",
      "pnpm install"
    ]
  },
  "terminals": [
    {
      "name": "Shell",
      "dir": "."
    }
  ],
  "run": [
    {
      "title": "Studio",
      "command": "pnpm run dev:studio",
      "restartOnRerun": true
    },
    {
      "title": "Test",
      "command": "pnpm run test",
      "restartOnRerun": false
    },
    {
      "title": "Storybook",
      "command": "pnpm run storybook",
      "restartOnRerun": false
    }
  ],
  "workspace_env": [],
  "protected_branches": []
}
